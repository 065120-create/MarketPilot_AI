{
  "name": "MarketPilot AI Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "marketpilot-webhook",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "marketpilot-ai-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [],
          "number": [],
          "string": [
            {
              "value1": "={{ $json.body.job_id }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.body.campaign }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Validate JSON",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Job ID": "={{ $json.body.job_id }}",
            "Brand": "={{ $json.body.campaign.brand }}",
            "Campaign": "={{ $json.body.campaign.campaign_name }}",
            "Date": "={{ $json.body.approved_at }}",
            "Budget": "={{ $json.body.campaign.budget }}",
            "Confidence Score": "={{ $json.body.confidence_score }}",
            "Key Findings": "={{ JSON.stringify($json.body.key_findings) }}",
            "Recommendations": "={{ JSON.stringify($json.body.recommendations) }}",
            "Status": "Approved"
          }
        }
      },
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [650, 200]
    },
    {
      "parameters": {
        "operation": "upload",
        "fileContent": "={{ $json.body.report_url }}",
        "fileName": "={{ $json.body.job_id }}_report.url",
        "options": {}
      },
      "name": "Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "fromEmail": "your-email@gmail.com",
        "toEmail": "executive@example.com",
        "subject": "=MarketPilot Campaign Approved: {{ $json.body.campaign.campaign_name }}",
        "html": "=<h2>Campaign Approved</h2><p>Job ID: {{ $json.body.job_id }}</p><p>Executive Summary:</p><p>{{ $json.body.executive_summary }}</p>",
        "options": {}
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"success\",\n  \"message\": \"Campaign data processed successfully.\"\n}",
        "options": {}
      },
      "name": "Webhook Response (Success)",
      "type": "n8n-nodes-base.webhookResponse",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"error\",\n  \"message\": \"Invalid JSON payload received.\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "name": "Webhook Response (Error)",
      "type": "n8n-nodes-base.webhookResponse",
      "typeVersion": 1,
      "position": [650, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate JSON": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Webhook Response (Error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          {
            "node": "Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Drive": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Webhook Response (Success)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}
